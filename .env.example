# Web3Forms access key — identifies which Web3Forms form configuration
# (tied to info@menascouae.com) a submission is delivered through. Used
# directly by the client in src/lib/contactApi.ts via
# import.meta.env.VITE_WEB3FORMS_ACCESS_KEY, so it IS shipped to the
# browser bundle by design — this is a public form identifier in Web3Forms'
# own architecture, not an SMTP password or API secret. Copy this file to
# .env.local for local development (see .gitignore — .env* is already
# ignored) and add the same variable under Vercel Project -> Settings ->
# Environment Variables for production/preview deployments.
VITE_WEB3FORMS_ACCESS_KEY=

# Public Newsroom API base URL — the deployed API Gateway invoke URL (e.g.
# https://wvojo9g543.execute-api.ap-south-1.amazonaws.com). This is PUBLIC
# configuration, not a secret: it's the address of a public, unauthenticated
# read-only API meant to be called directly by any browser. Never put
# NEWSROOM_ADMIN_API_KEY, DB credentials, or AWS credentials behind a
# VITE_* name — those must never reach the browser. Leave unset for local
# dev / same-origin Vercel deployments (requests stay relative,
# /api/newsroom/... — unchanged current behavior).
VITE_NEWSROOM_API_BASE_URL=

# ---------------------------------------------------------------------------
# Newsroom backend (Phase 1) — server-only, used by api/**, never by src/**.
# These are NOT VITE_* variables and are never shipped to the browser bundle.
# Copy this file to .env.local for local development (already gitignored).
# ---------------------------------------------------------------------------

# RDS MySQL 8.4 connection (menasco-newsroom-db, ap-south-1). Fill in the
# real endpoint/credentials locally only — never commit them. For local dev,
# use the same values that already connect successfully from your machine
# (the RDS security group currently allows only your IP). For production,
# these must come from Vercel's encrypted Environment Variables (Project ->
# Settings -> Environment Variables), not this file.
DB_HOST=
DB_PORT=3306
DB_NAME=menasco_newsroom
# Prefer the dedicated `newsroom_app` user (see
# migrations/create_app_db_user.sql.example) over the newsroom_admin master
# account for day-to-day application traffic.
DB_USER=newsroom_app
DB_PASSWORD=

# S3 (menasco-newsroom-prod, ap-south-1) — private bucket, no public ACLs.
AWS_REGION=ap-south-1
NEWSROOM_S3_BUCKET=menasco-newsroom-prod
# No AWS access-key/secret variables here: locally the AWS SDK's default
# credential chain picks up your existing AWS CLI/SSO profile automatically
# (whatever `aws configure`/`aws sso login` already set up); in a deployed
# AWS compute environment, prefer an attached IAM role instead of static
# keys. If a given production compute target genuinely requires static
# credentials, set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY as secure
# platform environment variables — never in this file.

# ---------------------------------------------------------------------------
# Newsroom admin proxy (Phase 6B) — THREE separate secrets, three separate
# jobs. Never conflate them, never let one substitute for another:
#
#   NEWSROOM_ADMIN_PROXY_PASSWORD  -> verifies the human admin login
#                                     (api/newsroom-admin-proxy/login.ts)
#   NEWSROOM_ADMIN_SESSION_SECRET  -> signs/verifies the HttpOnly admin
#                                     session cookie (api/_lib/adminProxySession.ts)
#   NEWSROOM_ADMIN_API_KEY         -> authenticates the Vercel proxy's
#                                     server-to-server calls to the real AWS
#                                     Lambda (api/newsroom-admin-proxy/[...path].ts
#                                     and, unchanged since Phase 1, every
#                                     api/newsroom/** handler's own
#                                     requireNewsroomAuth guard)
#
# None of the three ever reaches browser code, browser storage, a VITE_*
# variable, a log line, or an API response body — confirmed by this
# project's browser-bundle secret audit after every change to this area.
# Generate each independently, e.g.: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEWSROOM_ADMIN_PROXY_PASSWORD=
NEWSROOM_ADMIN_SESSION_SECRET=

# Every api/newsroom/** request (both when called directly, e.g. locally,
# and when called by the admin proxy server-to-server) must provide this
# value in the `x-newsroom-admin-key` header — see api/_lib/auth.ts.
NEWSROOM_ADMIN_API_KEY=

# Local-only convenience bypass for the above — NEVER set this in
# production. Only honored when NODE_ENV/VERCEL_ENV is not "production";
# the check is unconditional in code, not just a convention.
NEWSROOM_DEV_AUTH_BYPASS=true

# Base URL of the deployed Newsroom API Gateway/Lambda (same value as
# VITE_NEWSROOM_API_BASE_URL above, but read server-side, at both build
# time — scripts/newsroom-public-data.ts's prerender fetch — and runtime —
# api/newsroom-admin-proxy/[...path].ts forwards admin calls here). Not a
# secret; the "PUBLIC" in the name refers to this being non-sensitive
# config, not that only public routes live at this address.
NEWSROOM_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Projects admin proxy (Phase 4) — mirrors the Newsroom block above exactly,
# with its own separate secrets. Never reuse a Newsroom secret here and
# never let a Projects secret substitute for a Newsroom one — the two
# backends (menasco-newsroom-api / menasco-projects-api) are isolated Lambdas
# with isolated credentials end to end; sharing a secret would be the one
# thing that quietly re-couples them.
#
#   PROJECTS_ADMIN_PROXY_PASSWORD  -> verifies the human admin login
#                                     (api/projects-admin-proxy/login.ts)
#   PROJECTS_ADMIN_SESSION_SECRET  -> signs/verifies the HttpOnly admin
#                                     session cookie
#                                     (api/_lib/projectsAdminProxySession.ts)
#   PROJECTS_ADMIN_API_KEY         -> authenticates the Vercel proxy's
#                                     server-to-server calls to the real
#                                     menasco-projects-api Lambda
#                                     (api/projects-admin-proxy/[...path].ts
#                                     and every api/projects/** handler's own
#                                     requireProjectsAuth guard)
#
# Generate each independently, e.g.: openssl rand -base64 32
# ---------------------------------------------------------------------------
PROJECTS_ADMIN_PROXY_PASSWORD=
PROJECTS_ADMIN_SESSION_SECRET=

# Every api/projects/** request must provide this value in the
# x-projects-admin-key header — see api/_lib/projectsAuth.ts.
PROJECTS_ADMIN_API_KEY=

# Local-only convenience bypass for the above — NEVER set this in
# production. Only honored when NODE_ENV/VERCEL_ENV is not "production".
PROJECTS_DEV_AUTH_BYPASS=true

# Base URL of the deployed Projects API Gateway/Lambda
# (https://lldgps0rva.execute-api.ap-south-1.amazonaws.com) — read
# server-side by api/projects-admin-proxy/[...path].ts to forward admin
# calls. Not a secret.
PROJECTS_PUBLIC_API_BASE_URL=
