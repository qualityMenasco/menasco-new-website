{
  "name": "menasco-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:llms": "tsx scripts/generate-llms.ts",
    "prebuild": "npm run generate:llms",
    "build": "tsc -b && vite build",
    "postbuild": "tsx scripts/generate-seo-html.ts",
    "preview": "vite preview",
    "vercel:dev": "vercel dev",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types scripts/db-migrate.ts",
    "newsroom:e2e": "node --env-file=.env.local --experimental-strip-types scripts/newsroom-e2e-test.ts",
    "newsroom:e2e:direct": "tsx --env-file=.env.local scripts/newsroom-direct-handler-test.ts",
    "newsroom:pdf-pipeline:test": "tsx scripts/newsroom-pdf-pipeline-test.ts",
    "newsroom:process:e2e": "tsx --env-file=.env.local scripts/newsroom-process-e2e-test.ts",
    "newsroom:phase3:e2e": "tsx --env-file=.env.local scripts/newsroom-phase3-workflow-test.ts",
    "newsroom:phase4:e2e": "tsx --env-file=.env.local scripts/newsroom-phase4-workflow-test.ts",
    "newsroom:phase5:security": "tsx --env-file=.env.local scripts/newsroom-phase5-security-test.ts",
    "aws:adapter:test": "tsx scripts/aws-lambda-adapter-test.ts",
    "aws:lambda:real": "tsx --env-file=.env.local scripts/aws-lambda-real-test.ts",
    "aws:build-time:test": "tsx --env-file=.env.local scripts/aws-build-time-fetch-test.ts",
    "test": "vitest run",
    "newsroom:admin-proxy:test": "tsx --env-file=.env.local scripts/newsroom-admin-proxy-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "framer-motion": "^11.11.9",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^13.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
